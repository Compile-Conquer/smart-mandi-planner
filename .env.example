# MandiMitra AI Environment Configuration Example

# Data.gov.in API Key (Optional fallback for live AGMARKNET sync)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# OpenRouteService API Key (For matrix distance & driving routes calculation)
OPENROUTESERVICE_API_KEY=your_openrouteservice_key_here

# Database URL (Defaults to SQLite for local development; Render / Supabase PostgreSQL for production)
DATABASE_URL=sqlite:///./mandimitra.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@hostname:5432/mandimitra

# CORS / URLs
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
